{
  "name": "manga-collection-catalog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-manga-catalog --only firestore \"vitest run --config tests/vitest.rules.config.ts\"",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^15.34.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
